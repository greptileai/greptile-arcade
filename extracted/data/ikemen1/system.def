p1.accel = 0,0
p1.friction = 1,1
p1.pos = 0,0
p1.draworder = 3
p1.name.offset = 0,0
p1.name.font = -1,0,0
p1.name.layerno = 2
p1.applypal = 0
;Hide stock loser portrait and stock text; the custom SFF draws the UI.
