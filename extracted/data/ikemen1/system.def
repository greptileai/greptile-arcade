;-------------------------------------------------------------------
;Game over screen definition
[Game Over Screen]
enabled = 1               ;Set to 1 to show game over screen, 0 to disable
storyboard = gameover.def ;Game over storyboard filename

;-------------------------------------------------------------------
;Victory screen definition
;Komodo flow: final winner -> restart prompt -> title.
[Victory Screen]
enabled = 1
sounds.enabled = 0        ;Set to 0 to disable char sounds during Victory Screen
cpu.enabled = 1
vs.enabled = 1
keepside.enabled = 0
time = 600                ;Time to show screen before returning to startup
fadein.time = 8
fadeout.time = 15
skip.key = a
cancel.key = b, c, x, y, z, s
overlay.alpha = 0,256
;Winner pose. Sprite 9000,3 is packed into each mascot SFF.
;Victory portraits are auto-scaled from char localcoord 320x240 to motif
;localcoord 1280x720, so 0.25 cancels that 4x multiplier.
p1.anim = 9400
p1.offset = 20, 228
p1.spr = 9000,3
p1.layerno = 2
p1.facing = 1
p1.scale = 0.25,0.25
p1.window = 0,0, 1279,719
p1.localcoord = 1280,720
p1.num = 1
p1.spacing = 0,0
p1.padding = 0
